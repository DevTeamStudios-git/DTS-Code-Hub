# DTS Code Hub — API Environment Variables
# Copy this file to .env and fill in your values

# Supabase — get these from your Supabase project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Database — get from Supabase project Settings > Database > Connection string (URI mode)
# Use the "Session mode" connection string (port 5432) for Prisma
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# App
PORT=3001
NODE_ENV=development
WEB_URL=http://localhost:5173
